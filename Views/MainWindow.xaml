<Window x:Class="IptvPlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="IPTV Player" Height="720" Width="1180"
        MinHeight="480" MinWidth="760"
        Background="#FF101216" Foreground="#FFEDEDED"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Built-in WPF converter; instance needed for XAML use. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- top toolbar -->
            <RowDefinition Height="*"/>      <!-- panel + video -->
            <RowDefinition Height="Auto"/>   <!-- transport bar -->
        </Grid.RowDefinitions>

        <!-- ===== Top toolbar: panel toggle + channel search + URL load ===== -->
        <DockPanel x:Name="TopBar" Grid.Row="0" Background="#FF15181F" LastChildFill="True">
            <ToggleButton x:Name="PanelToggle" DockPanel.Dock="Left"
                          Content="&#9776; Channels" IsChecked="True"
                          Margin="8,6" Padding="10,4"
                          ToolTip="Show/hide the channel panel"/>

            <!-- Channel search box, right next to the Channels toggle. -->
            <Grid DockPanel.Dock="Left" Width="200" Margin="4,6">
                <TextBox x:Name="SearchBox" Padding="6,3"
                         VerticalContentAlignment="Center"
                         Background="#FF20242E" Foreground="White" BorderThickness="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- Placeholder shown only while the box is empty (no converter needed). -->
                <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                           Margin="8,0,0,0" Foreground="#FF8A8F99"
                           Text="Search / ძებნა">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button DockPanel.Dock="Right" Content="Load URL"
                    Margin="4,6,8,6" Padding="10,4"
                    Command="{Binding LoadUrlCommand}"/>
            <Button DockPanel.Dock="Right" Content="Open file..."
                    Margin="4,6" Padding="10,4"
                    Command="{Binding LoadFileCommand}"/>

            <TextBox VerticalContentAlignment="Center" Margin="8,6" Padding="6,3"
                     Background="#FF20242E" Foreground="White" BorderThickness="0"
                     Text="{Binding PlaylistUrl, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="http(s):// playlist URL"/>
        </DockPanel>

        <!-- ===== Middle: collapsible panel (col 0) + video (col 1) ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Auto column collapses to 0 width when SidePanel is hidden. -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidePanel" Grid.Column="0" Width="320"
                    Background="#FF15181F"
                    Visibility="{Binding IsChecked, ElementName=PanelToggle,
                                          Converter={StaticResource BoolToVis}}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ComboBox Grid.Row="0" Margin="0,0,0,6"
                              ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"/>

                    <CheckBox Grid.Row="1" Margin="2,0,0,8" Foreground="#FFEDEDED"
                              Content="&#9733; Favorites only"
                              IsChecked="{Binding ShowFavoritesOnly}"/>

                    <ListBox x:Name="ChannelList" Grid.Row="2"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#FFEDEDED"
                             ItemsSource="{Binding ChannelsView}"
                             SelectedItem="{Binding SelectedChannel}"
                             SelectionChanged="ChannelList_SelectionChanged"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <!-- Dark-theme item container: the default ListBoxItem renders
                             black text on our dark panel (invisible). This restyles it
                             with light text and a readable selection highlight. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="#FFEDEDED"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF2A2F3A"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF3D6FB4"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Channel number -->
                                    <TextBlock Grid.Column="0" Text="{Binding Number}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,6,0" FontSize="12" Opacity="0.55"/>
                                    <Image Grid.Column="1" Width="32" Height="32"
                                           Stretch="Uniform" Source="{Binding LogoUrl}"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                Margin="6,0,0,0">
                                        <!-- Inherit Foreground from the container so text
                                             stays light (and turns white when selected). -->
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Group}" FontSize="10"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Video is rendered directly into this WinForms panel's HWND (set in code-
                 behind via MediaPlayer.Hwnd). Reliable, no DWM-thumbnail compositing. -->
            <wfi:WindowsFormsHost x:Name="VideoHost" Grid.Column="1" Background="Black"/>
        </Grid>

        <!-- ===== Transport bar ===== -->
        <DockPanel x:Name="TransportBar" Grid.Row="2" Background="#FF15181F" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="&#9198;"  Margin="8,6,2,6" Padding="10,4"
                    Command="{Binding PrevChannelCommand}" ToolTip="Previous (Up)"/>
            <Button DockPanel.Dock="Left" Content="&#9199;"  Margin="2,6" Padding="10,4"
                    Command="{Binding PlayPauseCommand}" ToolTip="Play/Pause (Space)"/>
            <Button DockPanel.Dock="Left" Content="&#9209;"  Margin="2,6" Padding="10,4"
                    Command="{Binding StopCommand}"/>
            <Button DockPanel.Dock="Left" Content="&#9197;"  Margin="2,6" Padding="10,4"
                    Command="{Binding NextChannelCommand}" ToolTip="Next (Down)"/>

            <Button DockPanel.Dock="Left" Content="&#9733;" Margin="14,6,2,6" Padding="10,4"
                    Command="{Binding ToggleFavoriteCommand}" ToolTip="Toggle favorite"/>

            <!-- Aspect ratio quick-select -->
            <Button DockPanel.Dock="Left" Content="Auto" Margin="14,6,2,6" Padding="8,4"
                    Command="{Binding SetAspectCommand}" CommandParameter="Auto"/>
            <Button DockPanel.Dock="Left" Content="16:9" Margin="2,6" Padding="8,4"
                    Command="{Binding SetAspectCommand}" CommandParameter="16:9"/>
            <Button DockPanel.Dock="Left" Content="4:3"  Margin="2,6" Padding="8,4"
                    Command="{Binding SetAspectCommand}" CommandParameter="4:3"/>

            <!-- Fullscreen toggle (also F11; Esc exits). -->
            <Button DockPanel.Dock="Left" Content="&#x26F6; Fullscreen"
                    Margin="14,6,2,6" Padding="8,4"
                    Click="FullscreenButton_Click"
                    ToolTip="Fullscreen (F11) — Esc to exit"/>

            <!-- Volume: built-in Slider drag is sufficient. -->
            <Slider DockPanel.Dock="Right" Width="140" Margin="8,6"
                    VerticalAlignment="Center"
                    Minimum="0" Maximum="100"
                    Value="{Binding Volume, Mode=TwoWay}"
                    ToolTip="Volume (Left/Right)"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                       Margin="8,0" Opacity="0.8"
                       Text="{Binding StatusText}"/>
        </DockPanel>
    </Grid>
</Window>
